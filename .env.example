# ============================================================================
# wecom-ops-hub — 仅用于「首次启动」的引导参数
# 其余所有设置（企微凭据 / 监控目标 / 菜单 / 通知策略）都在 Web 面板里改
# ============================================================================

# 面板对外端口（宿主机端口 -> 容器 8080）
# 如果你的公网回调需要固定端口（例如 frp / 反向代理只转发某个端口），就改成那个端口
HUB_PORT=8080

# 面板初始登录密码（首次登录后可在面板里修改）
HUB_ADMIN_PASSWORD=admin

# 时区
TZ=Asia/Shanghai

# 数据目录（SQLite 数据库 + 日志），默认 ./data
HUB_DATA_DIR=./data
